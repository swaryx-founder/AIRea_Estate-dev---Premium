# Azure deployment — environment variables reference
# Set ALL of these in Azure Portal → your Container App / App Service → Configuration → Application settings
# Do NOT upload a .env file to Azure. Do NOT commit secrets to git.

# Required
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# GOOGLE_API_KEY=
# # Multi-key pool for parallel calls (comma-separated). Each concurrent call leases one key.
# Keys must be unique. Falls back to GOOGLE_API_KEY / GEMINI_API_KEY when unset.
# GEMINI_API_KEYS=keyA,keyB,keyC
# Or numbered: GEMINI_API_KEY_1=... GEMINI_API_KEY_2=...
# Wait when all keys are leased (default 30s) before failing the job.
# GEMINI_KEY_LEASE_TIMEOUT_SEC=30
# Optional Redis backend for multi-worker key leasing:
# REDIS_URL=redis://localhost:6379/0
# GEMINI_KEY_POOL_REDIS_PREFIX=gemini_key_pool
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# VOBIZ_SIP_DOMAIN=
# VOBIZ_USERNAME=
# VOBIZ_PASSWORD=
# Deprecated — do not set a default DID. Outbound caller IDs come from Vobiz phone pool sync.
# VOBIZ_OUTBOUND_NUMBER=
OUTBOUND_TRUNK_ID=
# Vobiz Console → Auth ID / Auth Token (for realtime CDR cost on Call Logs).
# Dashboard matches each call to Vobiz CDR total_cost (fallback = estimate below).
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Fallback when CDR not matched — Vobiz bills ceil(seconds/60) × rate (e.g. 209s → 4×0.45=₹1.80).
VOBIZ_RATE_PER_MINUTE=0.45
VOBIZ_BILLING_CURRENCY=INR
# Phone number pool — sync owned Vobiz DIDs into Supabase phone_numbers.
# PHONE_NUMBER_SYNC_INTERVAL_MINUTES=15
# PHONE_NUMBER_BUSY_MAX_MINUTES=75
# PHONE_NUMBER_JOB_LOCK_TTL_SEC=180

# Recommended defaults
GEMINI_MODEL=gemini-3.8-live
GEMINI_TTS_VOICE=Leda
USE_GEMINI_REALTIME=true
# LiveKit worker + default dispatch target — API and worker MUST use the same value.
# Prefer AI_AGENT_NAME (Azure DevOps predefines AGENT_NAME as the build agent name).
# Prod Azure: outbound-caller. Local/dev: ALWAYS a different name
# (e.g. outbound-caller-test-local) or they will steal production calls.
AI_AGENT_NAME=outbound-caller
LIVEKIT_AGENT_NAME=outbound-caller
# Max ring time before SIP gives up (also bounds idle Gemini Live while AMD waits).
RINGING_TIMEOUT_SEC=30
# Answering Machine Detection — blocks greeting until classify finishes.
# AMD_ENABLED=false → speak immediately after answer (no machine hangup).
# AMD_TIMEOUT_SEC caps how long we wait (default 2.5); then treat as uncertain and greet.
AMD_ENABLED=true
AMD_TIMEOUT_SEC=2.5
# Pre-render the default/reconnect greeting (Gemini TTS, same voice) while the phone rings
# and play it the moment the lead answers. false → Gemini Live generates it after pickup.
GREETING_AUDIO_PREFETCH=true
# Seconds to ignore barge-in at session start while telephony AEC settles (default 1.5).
AEC_WARMUP_SECONDS=1.5
# Reply latency (Gemini Live). Silence before Gemini replies — added to every turn.
# 150 default; 100 is faster but may cut Hinglish speakers off at natural pauses.
GEMINI_SILENCE_MS=150
# off (default) | minimal | low | medium | high. gemini-3.8-live rejects thinking_level —
# leave off unless the model supports it, or every call fails before dialing.
GEMINI_THINKING_LEVEL=off
# Compress older call context past this size so long calls stay fast (0 = off).
GEMINI_CONTEXT_TRIGGER_TOKENS=16000
GEMINI_CONTEXT_TARGET_TOKENS=8000
# Soft-prompt after lead stays silent following agent speech (SilenceFailsafe only).
# SILENCE_FAILSAFE_ENABLED=false disables hear-checks entirely (no legacy fallback).
# Default 7s; max soft prompts per call = 2; active-chat grace = 12s.
SILENCE_FAILSAFE_ENABLED=true
SILENCE_FAILSAFE_SEC=7
SILENCE_FAILSAFE_MAX=2
USER_SILENCE_ACTIVE_CHAT_SEC=12
# Default = Gemini Live native-audio (AI Studio GOOGLE_API_KEY only; may hit 1007).
# Set false for pipeline STT+LLM+TTS (needs GCP service account / billing — optional later).
#
# Live captions during the call (Gemini input/output audio transcription → Supabase).
# Default ON. Set false only if you see mid-call 1007 tied to the transcription channel.
ENABLE_LIVE_TRANSCRIPTION=true
#
# Pipeline only (USE_GEMINI_REALTIME=false): GCP SA JSON for Cloud STT/TTS.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
CONFIG_FROM_ENV_ONLY=true
PORT=8000
# Protect /api/* (except /api/health). Send Authorization: Bearer <token> or X-API-Key.
# Required in production — leave empty only for local open dashboard.
API_AUTH_TOKEN=

# Call recordings — Azure Blob only (NOT Supabase storage / S3_* vars)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=recordings

# Optional
DEFAULT_TRANSFER_NUMBER=
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_TIMEZONE=Asia/Kolkata
ENABLED_TOOLS=
SYSTEM_PROMPT=

# Node Calling Service — call sync after wrap_up
# Production (Azure Container Apps gateway):
# CALL_COMPLETED_WEBHOOK_URL=https://gateway.icymushroom-70c67802.canadacentral.azurecontainerapps.io/api/calls/webhook/call-completed
# Local dev (Node on port 5000):
CALL_COMPLETED_WEBHOOK_URL=http://localhost:5000/api/calls/webhook/call-completed
# Alternative: set base only — path /api/calls/webhook/call-completed is appended automatically
# CALLING_SERVICE_BASE_URL=https://gateway.icymushroom-70c67802.canadacentral.azurecontainerapps.io
# CALL_COMPLETED_WEBHOOK_SECRET=
# CALL_COMPLETED_WEBHOOK_ENABLED=true

# Meta WhatsApp Cloud API — post-call template message to lead
# META_WHATSAPP_TOKEN=EAAxxxxx
# META_WHATSAPP_PHONE_NUMBER_ID=123456789012345
# META_WHATSAPP_ENABLED=true
# META_WHATSAPP_TEMPLATE_PROJECT=project_details_followup
# META_WHATSAPP_TEMPLATE_BOOKED=site_visit_confirmation
# META_WHATSAPP_TEMPLATE_LANGUAGE=en

# Azure Communication Services Email — post-call follow-up to assigned agent
# ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
# ACS_SENDER_EMAIL=DoNotReply@<domain>.azurecomm.net
# ACS_EMAIL_ENABLED=true
# Optional fallback recipient when lead has no assigned_to_email:
# ACS_FOLLOWUP_TO=agent@example.com
# EMAIL_FOLLOWUP_AGENT_NAME=Agent

# Local development only — never set on Azure
# LOAD_DOTENV=true

# ── Premium voice stack ───────────────────────────────────────────────────────
# VOICE_STACK=cascade switches calls from Gemini Live to:
#   Sarvam Saaras STT -> Inception Mercury 2.5 -> Cartesia Sonic TTS (Indian female voices).
# No Gemini key is needed on this stack. Unset VOICE_STACK to go back to Gemini Live.
# VOICE_STACK=cascade
# INCEPTION_API_KEY=
# INCEPTION_MODEL=mercury-2.5
# INCEPTION_REASONING_EFFORT=none
# INCEPTION_MAX_COMPLETION_TOKENS=100   # replies are max 2 short sentences; longer = slower Mercury
# Speech-to-text: sarvam (default) or elevenlabs. Measured end of speech -> final text:
# Sarvam ~0.45s, ElevenLabs ~0.85s (same audio, 2026-10-12).
# STT_PROVIDER=sarvam
# SARVAM_API_KEY=                        # required for the default Sarvam STT
# ELEVEN_API_KEY=                        # only for STT_PROVIDER=elevenlabs (speech_to_text permission)
# ELEVEN_VAD_SILENCE_SECS=0.3            # 0.3 (fastest) – 3.0; silence that ends the lead's turn
# CARTESIA_API_KEY=                      # required: without it the job stops before dialing
# Voice is picked on the dashboard Voice tab (applies from the next call, no restart), or here:
# CARTESIA_VOICE_ID=95d51f79-c397-46f9-b49a-23763d3eaa2d   # Arushi - Hinglish Speaker
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_TTS_SPEED=1.0            # 0.6–1.5
# CARTESIA_TTS_VOLUME=1.0           # 0.5–2.0
# Reply latency (lead stops -> first audio). Watch the dashboard Latency tab / TURN_LATENCY logs.
# SARVAM_VAD_MIN_SILENCE_MS=220     # silence that ends the lead's turn; lower = faster, more cut-offs
# CASCADE_MIN_ENDPOINTING=0.1       # seconds
# CASCADE_MAX_ENDPOINTING=0.6
# LATENCY_TARGET_SECONDS=1.5
